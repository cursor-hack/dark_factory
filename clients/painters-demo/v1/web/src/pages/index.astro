---
import "../styles/global.css";
import PainterSection from "../components/PainterSection.astro";
import { painters } from "../data/painters";

const pageTitle = "Latvian Painters: Five Names That Matter";
const description =
  "A scroll-driven portrait of five Latvian painters: Kārlis Hūns, Jāzeps Grosvalds, Voldemārs Irbe, Kārlis Padegs, and Lucia Peka.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://enciklopedija.lv" crossorigin />
    <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />
    <link
      rel="preload"
      as="image"
      href={painters[0]?.meta.profile_image_url ?? ""}
      fetchpriority="high"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-title">{pageTitle}</div>
      <nav class="section-nav" aria-label="Section navigation">
        {painters.map((p, i) => (
          <a
            href={`#p-${i + 1}`}
            data-nav-target={`p-${i + 1}`}
            aria-label={`Go to ${p.meta.name_lv}`}
          />
        ))}
      </nav>
    </header>

    <main>
      {painters.map((p, i) => <PainterSection painter={p} index={i} />)}
    </main>

    <footer class="site-footer">
      Image and text sources: <a href="https://enciklopedija.lv" rel="noopener">enciklopedija.lv</a>.
    </footer>

    <div
      class="lightbox"
      id="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="Image preview"
      hidden
    >
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">×</button>
      <button type="button" class="lightbox-btn lightbox-prev" data-lightbox-prev aria-label="Previous image">‹</button>
      <img class="lightbox-img" id="lightbox-img" alt="" />
      <button type="button" class="lightbox-btn lightbox-next" data-lightbox-next aria-label="Next image">›</button>
      <div class="lightbox-caption" id="lightbox-caption" aria-live="polite"></div>
    </div>

    <script is:inline>
      // ----- Reveal-on-scroll -----
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => revealObserver.observe(el));

      // ----- Section in-view (ken-burns trigger) + nav dots -----
      const sections = Array.from(document.querySelectorAll(".painter"));
      const dots = Array.from(document.querySelectorAll(".section-nav a"));
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const id = entry.target.getAttribute("id");
            entry.target.classList.toggle("is-in-view", entry.isIntersecting);
            if (entry.isIntersecting && id) {
              dots.forEach((d) => {
                const target = d.getAttribute("data-nav-target");
                d.classList.toggle("is-active", target === id);
              });
            }
          }
        },
        { rootMargin: "-30% 0px -50% 0px", threshold: 0 },
      );
      sections.forEach((s) => sectionObserver.observe(s));

      // ----- Lightbox -----
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxCaption = document.getElementById("lightbox-caption");

      function buildGroup(thumb) {
        const strip = thumb.closest(".gallery-strip");
        if (!strip) return { items: [thumb], index: 0 };
        const items = Array.from(strip.querySelectorAll("[data-lightbox-src]"));
        return { items, index: items.indexOf(thumb) };
      }

      let current = { items: [], index: 0 };

      function showAt(i) {
        if (current.items.length === 0) return;
        current.index = (i + current.items.length) % current.items.length;
        const el = current.items[current.index];
        const src = el.getAttribute("data-lightbox-src");
        const alt = el.getAttribute("data-lightbox-alt") || "";
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightboxCaption.textContent =
          `${current.index + 1} / ${current.items.length}` + (alt ? ` — ${alt}` : "");
      }

      function openLightbox(thumb) {
        current = buildGroup(thumb);
        showAt(current.index);
        lightbox.removeAttribute("hidden");
        requestAnimationFrame(() => lightbox.classList.add("is-open"));
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        lightbox.classList.remove("is-open");
        document.body.style.overflow = "";
        setTimeout(() => {
          lightbox.setAttribute("hidden", "");
          lightboxImg.src = "";
        }, 220);
      }

      document.querySelectorAll("[data-lightbox-src]").forEach((thumb) => {
        thumb.addEventListener("click", () => openLightbox(thumb));
      });

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document
        .querySelector("[data-lightbox-close]")
        ?.addEventListener("click", closeLightbox);
      document
        .querySelector("[data-lightbox-prev]")
        ?.addEventListener("click", () => showAt(current.index - 1));
      document
        .querySelector("[data-lightbox-next]")
        ?.addEventListener("click", () => showAt(current.index + 1));

      window.addEventListener("keydown", (e) => {
        if (lightbox.hasAttribute("hidden")) return;
        if (e.key === "Escape") closeLightbox();
        else if (e.key === "ArrowLeft") showAt(current.index - 1);
        else if (e.key === "ArrowRight") showAt(current.index + 1);
      });
    </script>
  </body>
</html>
