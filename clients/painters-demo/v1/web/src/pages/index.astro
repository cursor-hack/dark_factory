---
import BaseLayout from "../layouts/BaseLayout.astro";

import meta1 from "../content/painters/01-rozentals/metadata.json";
import meta2 from "../content/painters/02-purvitis/metadata.json";
import meta3 from "../content/painters/03-valters/metadata.json";
import meta4 from "../content/painters/04-grosvalds/metadata.json";
import meta5 from "../content/painters/05-padegs/metadata.json";

import bio1 from "../content/painters/01-rozentals/bio.txt?raw";
import bio2 from "../content/painters/02-purvitis/bio.txt?raw";
import bio3 from "../content/painters/03-valters/bio.txt?raw";
import bio4 from "../content/painters/04-grosvalds/bio.txt?raw";
import bio5 from "../content/painters/05-padegs/bio.txt?raw";

interface PainterMeta {
  slug: string;
  name_lv: string;
  name_en: string;
  birth_year: number;
  death_year: number;
  profile_image_url: string;
  article_url: string;
  gallery: { url: string; alt: string }[];
}

const painters: { meta: PainterMeta; bio: string; eyebrow: string; sectionId: string }[] = [
  { meta: meta1 as PainterMeta, bio: bio1.trim(), eyebrow: "I",   sectionId: "section-1" },
  { meta: meta2 as PainterMeta, bio: bio2.trim(), eyebrow: "II",  sectionId: "section-2" },
  { meta: meta3 as PainterMeta, bio: bio3.trim(), eyebrow: "III", sectionId: "section-3" },
  { meta: meta4 as PainterMeta, bio: bio4.trim(), eyebrow: "IV",  sectionId: "section-4" },
  { meta: meta5 as PainterMeta, bio: bio5.trim(), eyebrow: "V",   sectionId: "section-5" },
];
---

<BaseLayout>
  <div
    class="lightbox"
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
    aria-hidden="true"
  >
    <figure class="lightbox-figure">
      <img class="lightbox-image" alt="" />
      <figcaption class="lightbox-caption"></figcaption>
      <button
        type="button"
        class="lightbox-button lightbox-prev"
        aria-label="Previous image"
      >‹</button>
      <button
        type="button"
        class="lightbox-button lightbox-next"
        aria-label="Next image"
      >›</button>
      <button
        type="button"
        class="lightbox-button lightbox-close"
        aria-label="Close"
      >✕</button>
    </figure>
  </div>

  {
    painters.map(({ meta, bio, eyebrow, sectionId }) => (
      <section
        id={sectionId}
        class="painter-section reveal"
        aria-labelledby={`${sectionId}-title`}
      >
        <div
          class="painter-hero reveal"
          style={`background-image: url('${meta.profile_image_url}');`}
          role="img"
          aria-label={`Portrait of ${meta.name_lv}`}
        >
          <div class="painter-hero-overlay" aria-hidden="true"></div>
          <div class="painter-hero-inner">
            <p class="eyebrow">{eyebrow}</p>
            <h2 id={`${sectionId}-title`} class="painter-name">
              <span class="name-lv">{meta.name_lv}</span>
              <span class="name-en" aria-hidden="true">{meta.name_en}</span>
            </h2>
            <p class="painter-years">
              {meta.birth_year}<span class="dash">–</span>{meta.death_year}
            </p>
          </div>
        </div>

        <div class="painter-body reveal">
          <p class="painter-bio">{bio}</p>

          <div
            class="gallery-strip"
            role="list"
            aria-label={`Selected works by ${meta.name_lv}`}
            data-painter-slug={meta.slug}
          >
            {meta.gallery.map((item, i) => (
              <figure class="gallery-item" role="listitem">
                <button
                  type="button"
                  class="gallery-trigger"
                  data-gallery-index={i}
                  aria-label={`Open image: ${item.alt}`}
                >
                  <img src={item.url} alt={item.alt} loading="lazy" decoding="async" />
                </button>
              </figure>
            ))}
          </div>

          <p class="painter-link-row">
            <a
              class="painter-link"
              href={meta.article_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Read on Encyclopaedia Latvija <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    ))
  }
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");

  if (reduceMotion || !("IntersectionObserver" in window)) {
    reveals.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
    );
    reveals.forEach((el) => io.observe(el));
  }
</script>

<script>
  // ---------- Lightbox ----------
  type LightboxItem = { url: string; alt: string };

  const lightbox = document.getElementById("lightbox") as HTMLElement | null;
  if (lightbox) {
    const imageEl = lightbox.querySelector<HTMLImageElement>(".lightbox-image")!;
    const captionEl = lightbox.querySelector<HTMLElement>(".lightbox-caption")!;
    const prevBtn = lightbox.querySelector<HTMLButtonElement>(".lightbox-prev")!;
    const nextBtn = lightbox.querySelector<HTMLButtonElement>(".lightbox-next")!;
    const closeBtn = lightbox.querySelector<HTMLButtonElement>(".lightbox-close")!;

    let currentItems: LightboxItem[] = [];
    let currentIndex = 0;
    let lastTrigger: HTMLElement | null = null;

    const render = () => {
      const item = currentItems[currentIndex];
      if (!item) return;
      imageEl.src = item.url;
      imageEl.alt = item.alt;
      captionEl.textContent = item.alt;
    };

    const openLightbox = (trigger: HTMLElement) => {
      const strip = trigger.closest(".gallery-strip");
      if (!strip) return;
      const triggers = Array.from(
        strip.querySelectorAll<HTMLButtonElement>(".gallery-trigger"),
      );
      const items: LightboxItem[] = triggers.map((t) => {
        const img = t.querySelector("img") as HTMLImageElement;
        return { url: img.src, alt: img.alt };
      });
      const idx = triggers.indexOf(trigger as HTMLButtonElement);
      if (idx < 0 || items.length === 0) return;
      currentItems = items;
      currentIndex = idx;
      lastTrigger = trigger;
      render();
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.classList.add("lightbox-open");
      closeBtn.focus();
    };

    const closeLightbox = () => {
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.classList.remove("lightbox-open");
      if (lastTrigger) {
        lastTrigger.focus();
        lastTrigger = null;
      }
      currentItems = [];
    };

    const step = (delta: number) => {
      if (currentItems.length === 0) return;
      currentIndex = (currentIndex + delta + currentItems.length) % currentItems.length;
      render();
    };

    document.querySelectorAll<HTMLButtonElement>(".gallery-trigger").forEach((btn) => {
      btn.addEventListener("click", () => openLightbox(btn));
    });

    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    closeBtn.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox.classList.contains("is-open")) return;
      if (e.key === "Escape") {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        step(1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        step(-1);
      }
    });
  }

  // ---------- Dot-nav scroll tracking ----------
  const dotLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".dot-nav a[data-target]"),
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>(".painter-section"),
  );

  if (dotLinks.length > 0 && sections.length > 0 && "IntersectionObserver" in window) {
    const setActive = (id: string) => {
      dotLinks.forEach((a) => {
        a.classList.toggle("is-active", a.dataset.target === id);
      });
    };

    // Use a thin band just below the sticky header so only one section is active.
    const navIO = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target.id) {
            setActive(entry.target.id);
          }
        }
      },
      { rootMargin: "-56px 0px -70% 0px", threshold: 0 },
    );

    sections.forEach((s) => navIO.observe(s));
    // Default the first dot to active until the observer fires.
    if (sections[0]?.id) setActive(sections[0].id);
  }
</script>
